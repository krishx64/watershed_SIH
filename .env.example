# =================================================================
# Watershed Signal — Environment Configuration Template (.env.example)
# Problem Statement: SIH 2026 PS-26015 | Ministry of Rural Development (DoLR)
# =================================================================

# -----------------------------------------------------------------
# 1. ISRO Bhuvan Open Data APIs (Ground Truth Baseline Verification)
# Obtain official access tokens at: https://bhuvan-app1.nrsc.gov.in/bhuvan2d/bhuvan/bhuvan2d.php
# -----------------------------------------------------------------
BHUVAN_TOKEN_LULC=your_bhuvan_lulc_token_here
BHUVAN_TOKEN_GEOID=your_bhuvan_geoid_token_here
BHUVAN_TOKEN_VRG=your_bhuvan_vrg_token_here

# -----------------------------------------------------------------
# 2. ISRO Bhoonidhi OpenSearch & Data Portal (Sovereign Satellite Ingestion)
# Register for free credentials at: https://bhoonidhi.nrsc.gov.in/bhoonidhi/
# -----------------------------------------------------------------
BHOONIDHI_USER=your_bhoonidhi_username
BHOONIDHI_PASSWORD=your_bhoonidhi_password
# Set to 'true' to permit automated background downloading of Indian Resourcesat-2A LISS-III scenes
BHOONIDHI_LIVE_DOWNLOAD=false

# -----------------------------------------------------------------
# 3. High-Performance Caching & Persistent Document Storage
# -----------------------------------------------------------------
# Redis In-Memory Cache (defaults to embedded daemon in Docker)
REDIS_URL=redis://127.0.0.1:6379

# MongoDB Compass / Local / Atlas (Statutory Audit Logs & Pre-warmed Tensors)
# For local development: mongodb://127.0.0.1:27017
# For Docker Compose:   mongodb://host.docker.internal:27017
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=watershed_db

# -----------------------------------------------------------------
# 4. Institutional Security & Role-Based Access Control
# -----------------------------------------------------------------
# Secret key used for signing stateless HMAC-SHA256 officer session tokens
AUTH_SECRET_KEY=watershed_signal_secret_key_sih2026_ps26015_replace_in_production

# Statutory Passkey required to register Administrator / Statutory Auditor accounts
ADMIN_PASSKEY=ADMIN_SIH_2026

# -----------------------------------------------------------------
# 5. Backend Service Configuration (Python REST API Bridge)
# -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# -----------------------------------------------------------------
# 6. Frontend Web Application (Next.js)
# -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
