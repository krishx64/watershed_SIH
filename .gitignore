# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Streamlit -- config.toml (the theme) is fine to commit; secrets are not
**/.streamlit/secrets.toml

# Pipeline data -- regenerated by src/data_download.py, preprocessing.py,
# tiling.py (or the Colab notebook). Includes raw/processed rasters and the
# tiled .npz training set, which can run into thousands of small files.
project/data/

# Trained model checkpoints -- large binaries (tens of MB), regenerate via
# the Colab notebook. If you want to commit a known-good checkpoint anyway,
# either use `git add -f` on that one file or set up Git LFS instead of
# removing this line (GitHub warns above 50MB, hard-blocks above 100MB).
project/models/*.pt

# Generated demo outputs -- regenerated by inference_demo.py / the app
project/outputs/*.png
project/outputs/*.html

# Claude Code project-local state
.claude/

# web/ -- Next.js frontend (marketing site + /try demo)
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Secrets / environment
.env
*.env
.env.*
.vercel
